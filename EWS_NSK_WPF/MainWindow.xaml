<Window x:Class="EWS_NSK_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ГЕОИНФОРМАЦИОННАЯ СИСТЕМА ИНППВ" 
        Height="915" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#002864">

    <Grid>
        <!-- Колонки -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Строки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ФОН -->
        <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2" 
               Source="/Resources/background.png" 
               Stretch="UniformToFill"/>

        <!-- ТЁМНЫЙ СЛОЙ -->
        <Rectangle x:Name="DarkOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2" 
                   Fill="Black" Opacity="0" IsHitTestVisible="False"/>

        <!-- БОКОВОЕ МЕНЮ -->
        <Border x:Name="SidebarBorder" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="#C8002864">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,15,0,15">
                    <Image Source="/Resources/logo.png" Width="110" Height="110" Margin="0,0,0,20" Stretch="Uniform" HorizontalAlignment="Center"/>

                    <!-- НАСТРОЙКИ -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Image Source="/Resources/settings_icon.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="НАСТРОЙКИ" Foreground="Orange" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Пользователь" Foreground="White" FontSize="11" Margin="30,8,0,0"/>
                        <ComboBox x:Name="UserStatusCombo" Margin="20,5,20,0" Height="25" Background="#003C78" Foreground="Black" BorderBrush="Transparent" DropDownOpened="UserStatusCombo_DropDownOpened">
                            <ComboBoxItem Content="Гость" IsSelected="True"/>
                        </ComboBox>
                        <TextBlock Text="Территория" Foreground="White" FontSize="11" Margin="30,10,0,0"/>
                        <ComboBox x:Name="TerritoryCombo" Margin="20,5,20,0" Height="25" Background="#003C78" Foreground="Black" BorderBrush="Transparent" DropDownOpened="TerritoryCombo_DropDownOpened">
                            <ComboBoxItem Content="г. Новосибирск" IsSelected="True"/>
                            <ComboBoxItem Content="г. Бердск"/>
                            <ComboBoxItem Content="г. Искитим"/>
                            <ComboBoxItem Content="Новосибирский район"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- КАРТА ПГ -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Image Source="/Resources/map_icon.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="КАРТА ПГ" Foreground="Orange" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Просмотр" Foreground="White" FontSize="11" Margin="30,8,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="КАРТА ПГ"/>
                        <TextBlock Text="Редактирование" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="КАРТА ПГ"/>
                    </StackPanel>

                    <!-- ЖУРНАЛЫ -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Image Source="/Resources/journal_icon.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="ЖУРНАЛЫ" Foreground="Orange" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Учёт ИНППВ" Foreground="White" FontSize="11" Margin="30,8,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ЖУРНАЛЫ"/>
                        <TextBlock Text="Проверки ПГ" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ЖУРНАЛЫ"/>
                    </StackPanel>

                    <!-- ОТЧЁТЫ -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Image Source="/Resources/report_icon.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="ОТЧЁТЫ по ИНППВ" Foreground="Orange" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="По территории" Foreground="White" FontSize="11" Margin="30,8,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ОТЧЁТЫ"/>
                        <TextBlock Text="По районам выезда" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ОТЧЁТЫ"/>
                        <TextBlock Text="По балансодержателю" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ОТЧЁТЫ"/>
                    </StackPanel>

                    <!-- ПЛАНШЕТ ИНППВ -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Image Source="/Resources/tablet_icon.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="ПЛАНШЕТ ИНППВ" Foreground="Orange" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Просмотр" Foreground="White" FontSize="11" Margin="30,8,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ПЛАНШЕТ ИНППВ"/>
                        <TextBlock Text="Формирование" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ПЛАНШЕТ ИНППВ"/>
                    </StackPanel>

                    <!-- СПРАВОЧНИКИ -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Image Source="/Resources/guide_icon.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="СПРАВОЧНИКИ" Foreground="Orange" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Подразделения ППС" Foreground="White" FontSize="11" Margin="30,8,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="СПРАВОЧНИКИ"/>
                        <TextBlock Text="Адресные объекты" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="СПРАВОЧНИКИ"/>
                        <TextBlock Text="Характеристики" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="СПРАВОЧНИКИ"/>
                        <TextBlock Text="Параметры проверок" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="СПРАВОЧНИКИ"/>
                        <TextBlock Text="Балансодержатели" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="СПРАВОЧНИКИ"/>
                    </StackPanel>

                    <!-- ОБМЕН ДАННЫМИ -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Image Source="/Resources/swap_icon.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="ОБМЕН ДАННЫМИ" Foreground="Orange" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Импорт" Foreground="White" FontSize="11" Margin="30,8,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ОБМЕН ДАННЫМИ"/>
                        <TextBlock Text="Экспорт" Foreground="White" FontSize="11" Margin="30,4,0,0" Cursor="Hand" MouseLeftButtonUp="SidebarItem_Click" Tag="ОБМЕН ДАННЫМИ"/>
                    </StackPanel>

                   
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ШАПКА -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Grid.Column="1" Background="#B400143C">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="40,0,0,0">
                    <TextBlock Text="ГЕОИНФОРМАЦИОННАЯ СИСТЕМА" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="ИНППВ г. Новосибирска и Новосибирского района НСО" FontSize="14" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Кнопка переключения темы -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" Cursor="Hand" MouseLeftButtonUp="ThemeToggle_Click">
                    <Image x:Name="ThemeIcon" Source="/Resources/moon_icon_hd.jpg" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ThemeLabel" Text="Тёмная тема" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Версия -->
                <TextBlock Grid.Column="2" Text="v. 2026" FontSize="14" Foreground="White" TextDecorations="Underline" Margin="0,0,30,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Приветствие -->
            <StackPanel Grid.Row="0" Margin="50,30,0,0">
                <TextBlock x:Name="GreetingLabel" Text="Добро пожаловать!" FontSize="28" FontWeight="Bold" Foreground="White" Height="38"/>
                <TextBlock Text="Выберите раздел системы для работы" FontSize="24" Foreground="White" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- СЕТКА ПЛИТОК -->
            <Border x:Name="TilesContainer" Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ПЛИТКА 1: КАРТА ПГ -->
                    <Border Grid.Row="0" Grid.Column="2" Margin="20,36,20,10" Cursor="Hand" MouseLeftButtonUp="Tile_Click" Tag="КАРТА ПГ">
                        <Grid>
                            <Rectangle x:Name="TileMapBackground">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Resources/tile_frame.png" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Resources/map_icon.png" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TileMapTitle" Text="КАРТА ПГ" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TileMapDesc" Text="Просмотр и работа с картой пожарных гидрантов" FontSize="11" Foreground="LightGray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ПЛИТКА 2: ЖУРНАЛЫ -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="41,20,10,20" Cursor="Hand" MouseLeftButtonUp="Tile_Click" Tag="ЖУРНАЛЫ">
                        <Grid>
                            <Rectangle x:Name="TileJournalsBackground">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Resources/tile_frame.png" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Resources/journal_icon.png" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TileJournalsTitle" Text="ЖУРНАЛЫ" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TileJournalsDesc" Text="Учёт водоисточников. Проверки пожарных гидрантов" FontSize="11" Foreground="LightGray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ПЛИТКА 3: ОТЧЁТЫ -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="20" Cursor="Hand" MouseLeftButtonUp="Tile_Click" Tag="ОТЧЁТЫ">
                        <Grid>
                            <Rectangle x:Name="TileReportsBackground">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Resources/tile_frame.png" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Resources/report_icon.png" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TileReportsTitle" Text="ОТЧЁТЫ" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TileReportsDesc" Text="Формирование отчётов по водоисточникам" FontSize="11" Foreground="LightGray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ПЛИТКА 4: ПЛАНШЕТ ИНППВ -->
                    <Border Grid.Row="1" Grid.Column="2" Margin="20,20,20,20" Cursor="Hand" MouseLeftButtonUp="Tile_Click" Tag="ПЛАНШЕТ ИНППВ">
                        <Grid>
                            <Rectangle x:Name="TileTabletBackground">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Resources/tile_frame.png" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Resources/tablet_icon_hd.png" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TileTabletTitle" Text="ПЛАНШЕТ ИНППВ" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TileTabletDesc" Text="Просмотр и формирование справочников" FontSize="11" Foreground="LightGray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ПЛИТКА 5: СПРАВОЧНИКИ -->
                    <Border Grid.Row="2" Grid.Column="0" Margin="41,20,10,20" Cursor="Hand" MouseLeftButtonUp="Tile_Click" Tag="СПРАВОЧНИКИ">
                        <Grid>
                            <Rectangle x:Name="TileReferencesBackground">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Resources/tile_frame.png" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Resources/guide_icon.png" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TileReferencesTitle" Text="СПРАВОЧНИКИ" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TileReferencesDesc" Text="Работа со справочниками и классификаторами" FontSize="11" Foreground="LightGray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ПЛИТКА 6: ОБМЕН ДАННЫМИ -->
                    <Border Grid.Row="2" Grid.Column="1" Margin="20" Cursor="Hand" MouseLeftButtonUp="Tile_Click" Tag="ОБМЕН ДАННЫМИ">
                        <Grid>
                            <Rectangle x:Name="TileExchangeBackground">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Resources/tile_frame.png" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Resources/swap_icon_hd.png" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TileExchangeTitle" Text="ОБМЕН ДАННЫМИ" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TileExchangeDesc" Text="Импорт и экспорт данных по водоисточникам" FontSize="11" Foreground="LightGray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ПОДВАЛ -->
        <Border x:Name="FooterBorder" Grid.Row="2" Grid.Column="1" Background="#B4000000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Yaroslavtseva I.V." Foreground="White" FontSize="14" Margin="40,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,30,0" Cursor="Hand" MouseLeftButtonUp="Exit_Click">
                    <Image Source="/Resources/exit.png" Width="35" Height="35" Stretch="Uniform"/>
                    <TextBlock Text="ВЫХОД" FontSize="14" FontWeight="Bold" Foreground="Orange" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>