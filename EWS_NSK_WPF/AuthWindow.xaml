<Window x:Class="EWS_NSK_WPF.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Авторизация" 
        Height="370" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" 
        WindowStyle="SingleBorderWindow"
        Background="#002864">

    <Canvas Margin="20">

        <!-- Заголовок (остается оранжевым в любой теме) -->
        <TextBlock Canvas.Left="0" Canvas.Top="0" 
                   Text="Вход в систему" 
                   FontSize="18" FontWeight="Bold" Foreground="Orange"/>

        <!-- Логин (добавлен x:Name="LoginLabel") -->
        <TextBlock x:Name="LoginLabel" Canvas.Left="0" Canvas.Top="40" Text="Логин" Foreground="White" FontSize="12"/>
        <TextBox x:Name="LoginBox" Canvas.Left="0" Canvas.Top="60" Width="280" Height="28" FontSize="12"/>

        <!-- Пароль (добавлен x:Name="PasswordLabel") -->
        <TextBlock x:Name="PasswordLabel" Canvas.Left="0" Canvas.Top="100" Text="Пароль" Foreground="White" FontSize="12"/>
        <PasswordBox x:Name="PasswordBox" Canvas.Left="0" Canvas.Top="120" Width="280" Height="28" FontSize="12"/>

        <!-- Дата (добавлен x:Name="DateLabel") -->
        <TextBlock x:Name="DateLabel" Canvas.Left="0" Canvas.Top="170" Text="Дата" Foreground="White" FontSize="12"/>
        <DatePicker x:Name="DateBox" Canvas.Left="0" Canvas.Top="190" Width="280" Height="28" FontSize="12" SelectedDate="{x:Static sys:DateTime.Today}"/>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="ErrorLabel" Canvas.Left="0" Canvas.Top="230" 
                   Text="" Foreground="OrangeRed" FontSize="10" FontStyle="Italic" Width="280"/>

        <!-- Кнопки -->
        <Button Content="Войти" Canvas.Left="100" Canvas.Top="260" 
                Width="80" Height="30"
                Background="Orange" Foreground="White" FontWeight="Bold" BorderBrush="Transparent"
                Click="OkButton_Click" IsDefault="True"/>

        <Button Content="Отмена" Canvas.Left="190" Canvas.Top="260" 
                Width="80" Height="30"
                Background="#003C78" Foreground="White" BorderBrush="Transparent"
                Click="CancelButton_Click" IsCancel="True"/>

    </Canvas>
</Window>