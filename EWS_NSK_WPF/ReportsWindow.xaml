<Window x:Class="EWS_NSK_WPF.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Формирование отчетов" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#002864">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ: Заголовок и регулятор шрифта -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="ФОРМИРОВАНИЕ ОТЧЕТОВ" FontSize="22" FontWeight="Bold" Foreground="Orange"/>
                <TextBlock x:Name="UserInfoLabel" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
                <TextBlock x:Name="PermissionsLabel" FontSize="11" Foreground="Orange" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Регулятор размера шрифта -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="A" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="FontSizeSlider" Width="100" Minimum="9" Maximum="16" Value="11" 
                TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="FontSizeSlider_ValueChanged"/>
                <TextBlock Text="A" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ОСНОВНАЯ ЧАСТЬ: Левая панель + (Превью и Действия) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ: Выбор типа отчета -->
            <Border x:Name="LeftPanelBorder" Grid.Column="0" CornerRadius="4" BorderBrush="Orange" BorderThickness="1" Margin="0,0,5,0" Padding="8" Background="#003C78">
                <StackPanel>
                    <TextBlock Text="Типы отчетов:" FontSize="12" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,8"/>
                    <Button Content="📄 Общий список гидрантов" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReportType_Click" Tag="All"/>
                    <Button Content="⚠️ Ведомость неисправных" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReportType_Click" Tag="Defective"/>
                    <Button Content="🏢 По балансодержателям" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReportType_Click" Tag="ByOwner"/>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ: Превью таблицы и Кнопки -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Таблица превью (показывает, что пойдет в отчет) -->
                <Border Grid.Row="0" CornerRadius="4" BorderBrush="Orange" BorderThickness="1" Padding="4" Margin="0,0,0,10" Background="White">
                    <DataGrid x:Name="PreviewDataGrid" 
          AutoGenerateColumns="True" 
          ColumnWidth="Auto"
          IsReadOnly="True" 
          CanUserAddRows="False"
          HeadersVisibility="Column"
          FontSize="11"
          GridLinesVisibility="All"
          EnableRowVirtualization="True"
          Foreground="{DynamicResource DataGridForeground}"
                   Background="{DynamicResource DataGridBackground}"
          RowBackground="{DynamicResource DataGridRowBackground}"
          AlternatingRowBackground="{DynamicResource DataGridAltRowBackground}"
          BorderThickness="0"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#003C78"/>
                                <Setter Property="Foreground" Value="Orange"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource DataGridForeground}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2196F3"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>

                <!-- Панель действий -->
                <Border Grid.Row="1" Background="#003C78" CornerRadius="4" Padding="10" BorderBrush="Orange" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewCountLabel" Text="Всего записей: 0" FontSize="12" Foreground="White"/>
                            <TextBlock Text="Выберите тип отчета слева и нажмите 'Сформировать'" FontSize="10" Foreground="LightGray" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnGenerateWord" Content="💾 Сформировать Word" Width="160" Height="32" Margin="0,0,10,0"
                                    Background="#4CAF50" Foreground="White" BorderBrush="Transparent" 
                                    FontWeight="Bold" Cursor="Hand" Click="BtnGenerateWord_Click"/>
                            <Button x:Name="BtnExportExcel" Content="📊 Экспорт в Excel" Width="140" Height="32"
                                    Background="#FF9800" Foreground="White" BorderBrush="Transparent" 
                                    FontWeight="Bold" Cursor="Hand" Click="BtnExportExcel_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>