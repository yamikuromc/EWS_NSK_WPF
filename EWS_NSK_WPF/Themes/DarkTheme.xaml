<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета окна -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E32"/>
    <SolidColorBrush x:Key="LabelForeground" Color="#FFFFFF"/>

    <!-- Цвета полей ввода -->
    <SolidColorBrush x:Key="InputBackground" Color="#2A2A4A"/>
    <SolidColorBrush x:Key="InputForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A3A5A"/>

    <!-- Цвета шапки -->
    <SolidColorBrush x:Key="HeaderBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="MapBorderBrush" Color="Orange"/>

    <!-- Цвета DataGrid -->
    <SolidColorBrush x:Key="DataGridBackground" Color="#141432"/>
    <SolidColorBrush x:Key="DataGridForeground" Color="White"/>
    <SolidColorBrush x:Key="DataGridRowBackground" Color="#191937"/>
    <SolidColorBrush x:Key="DataGridAltRowBackground" Color="#232346"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#003C78"/>
    <SolidColorBrush x:Key="DataGridHeaderForeground" Color="Orange"/>
    <SolidColorBrush x:Key="DataGridBorderBrush" Color="#3C3C64"/>

    <!-- Цвета кнопок -->
    <SolidColorBrush x:Key="ButtonEditBackground" Color="#FF9800"/>
    <SolidColorBrush x:Key="ButtonSaveBackground" Color="#4CAF50"/>
    <SolidColorBrush x:Key="ButtonCancelBackground" Color="#003C78"/>

    <!-- Акцентные цвета -->
    <SolidColorBrush x:Key="AccentOrange" Color="Orange"/>
    <SolidColorBrush x:Key="TextWhite" Color="White"/>

    <!-- Стиль для ReadOnly TextBox -->
    <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#2A2A4A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#3C3C64"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

</ResourceDictionary>