<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета окна -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F5F5FA"/>
    <SolidColorBrush x:Key="LabelForeground" Color="#002864"/>

    <!-- Цвета полей ввода -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForeground" Color="#000000"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CCCCCC"/>

    <!-- Цвета шапки -->
    <SolidColorBrush x:Key="HeaderBackground" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="MapBorderBrush" Color="Orange"/>

    <!-- Цвета DataGrid -->
    <SolidColorBrush x:Key="DataGridBackground" Color="White"/>
    <SolidColorBrush x:Key="DataGridForeground" Color="Black"/>
    <SolidColorBrush x:Key="DataGridRowBackground" Color="White"/>
    <SolidColorBrush x:Key="DataGridAltRowBackground" Color="#F0F8FF"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#003C78"/>
    <SolidColorBrush x:Key="DataGridHeaderForeground" Color="Orange"/>
    <SolidColorBrush x:Key="DataGridBorderBrush" Color="Transparent"/>

    <!-- Цвета кнопок -->
    <SolidColorBrush x:Key="ButtonEditBackground" Color="#FF9800"/>
    <SolidColorBrush x:Key="ButtonSaveBackground" Color="#4CAF50"/>
    <SolidColorBrush x:Key="ButtonCancelBackground" Color="#003C78"/>

    <!-- Акцентные цвета -->
    <SolidColorBrush x:Key="AccentOrange" Color="Orange"/>
    <SolidColorBrush x:Key="TextWhite" Color="White"/>

    <!-- Стиль для ReadOnly TextBox -->
    <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#F5F5F5"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

</ResourceDictionary>