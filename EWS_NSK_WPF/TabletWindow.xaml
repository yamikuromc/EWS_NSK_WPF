<Window x:Class="EWS_NSK_WPF.TabletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планшет ИНППВ" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#002864">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ПЛАНШЕТ ИНППВ" FontSize="24" FontWeight="Bold" Foreground="Orange"/>
            <TextBlock x:Name="UserInfoLabel" FontSize="14" Foreground="White" Margin="0,10,0,0"/>
            <TextBlock x:Name="PermissionsLabel" FontSize="12" Foreground="LightGray" FontStyle="Italic" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#003C78" CornerRadius="10" BorderBrush="Orange" BorderThickness="2">
            <TextBlock Text="ЗДЕСЬ БУДУТ ПЛАНШЕТЫ: Фрагменты карты с объектами ИНППВ (по ГОСТ)" 
                       FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnCreate" Content="📄 Создать планшет" Width="140" Height="35" Margin="0,0,10,0" 
                    Background="Green" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Visibility="Collapsed"/>
            <Button Content="Закрыть" Width="100" Height="35" Background="#555" Foreground="White" 
                    BorderBrush="Transparent" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>