<Application x:Class="EWS_NSK_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EWS_NSK_WPF"
             xmlns:converters="clr-namespace:EWS_NSK_WPF.Converters"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- РЕСУРСЫ ПО УМОЛЧАНИЮ (светлая тема как fallback) -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F5F5FA"/>
        <SolidColorBrush x:Key="LabelForeground" Color="#002864"/>
        <SolidColorBrush x:Key="ButtonCancelBackground" Color="#003C78"/>
        <SolidColorBrush x:Key="ButtonSaveBackground" Color="#4CAF50"/>
        <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputForeground" Color="#000000"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CCCCCC"/>

        <!-- Конвертеры -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Стиль TextBox только для чтения -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#E8E8F0"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>

        <!-- УМНЫЙ ПОЛЗУНОК ДЛЯ ВСЕГО ПРИЛОЖЕНИЯ (вертикальный) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#AA888888" Margin="1,0,1,0"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>