<Window x:Class="EWS_NSK_WPF.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        Title="Карта пожарных гидрантов" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#002864">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Компактная шапка -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Background="#1E1E1E" Padding="10,8" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть: заголовок сверху, предупреждение снизу -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Строка 1: название + инфо + режим -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MapTitleText" 
                   Text="КАРТА ПОЖАРНЫХ ГИДРАНТОВ" 
                   FontSize="16" FontWeight="Bold" Foreground="Orange"
                   VerticalAlignment="Center"/>
                        <TextBlock Text="  |  " Foreground="Gray" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UserInfoLabel" 
                   FontSize="12" Foreground="White" 
                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="EditModeIndicator" 
                   Text=" | ✏️ РЕЖИМ РЕДАКТИРОВАНИЯ" 
                   FontSize="12" FontWeight="Bold" Foreground="Red"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Строка 2: предупреждение (появляется ТОЛЬКО при изменениях) -->
                    <Border x:Name="UnsavedWarningBorder" 
            Background="#30FF0000" BorderBrush="Red" BorderThickness="1" 
            CornerRadius="3" Padding="6,2" Margin="0,4,0,0"
            HorizontalAlignment="Left"
            Visibility="Collapsed">
                        <TextBlock Text="⚠ КОНФИГУРАЦИЯ ДАННЫХ НЕ СОХРАНЕНА!" 
                   FontSize="11" FontWeight="Bold" Foreground="Red"/>
                    </Border>
                </StackPanel>
                <!-- Правая часть: ПОИСК (цельный блок) + РЕЖИМ РЕДАКТИРОВАНИЯ -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">

                    <!-- 1. Поле поиска -->
                    <TextBox x:Name="SearchTextBox" 
                             Width="250" Height="28" 
                             FontSize="12" VerticalContentAlignment="Center"
                             Background="White" Foreground="Black" BorderBrush="#555"
                             Padding="5,3" Margin="0,0,5,0"
                             ToolTip="Введите номер, адрес или координаты"
                             KeyDown="SearchTextBox_KeyDown"/>

                    <!-- 2. Кнопка поиска (сразу за полем) -->
                    <Button Content="🔍" Width="32" Height="28" Margin="0,0,5,0"
                            Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14"
                            BorderBrush="Transparent" Cursor="Hand"
                            Click="SearchHydrant_Click" ToolTip="Поиск"/>

                    <!-- 3. Кнопка очистки (сразу за лупой) -->
                    <Button Content="✖" Width="32" Height="28" Margin="0,0,10,0"
                            Background="#003C78" Foreground="White" FontWeight="Bold" FontSize="14"
                            BorderBrush="Transparent" Cursor="Hand"
                            Click="ClearSearch_Click" ToolTip="Очистить"/>

                    <!-- 4. Кнопка входа в режим редактирования (в самом конце) -->
                    <Button x:Name="EditModeToggleButton" 
                    Content="✏️ Режим редактирования" 
                    Width="190" Height="28" Margin="0,0,10,0"
                    Background="#FF9800" Foreground="White" BorderBrush="Transparent"
                    Cursor="Hand" Visibility="Collapsed"
                    Click="EnterEditMode_Click"
                    ToolTip="Включить режим редактирования"/>

                    <!-- 5. Панель действий в режиме редактирования (заменяет кнопку выше) -->
                    <StackPanel x:Name="EditModeActions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,0">
                        <!-- 👇 ДОБАВЛЕНО: Click="SaveChanges_Click" -->
                        <Button Content="💾 Сохранить" Width="100" Height="28" Margin="0,0,5,0"
            Background="#4CAF50" Foreground="White" BorderBrush="Transparent" Cursor="Hand"
            Click="SaveChanges_Click"/>

                        <Button Content="❌ Выйти" Width="80" Height="28"
            Background="#F44336" Foreground="White" BorderBrush="Transparent" Cursor="Hand"
            Click="ExitEditMode_Click"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Карта -->
        <wpf:GMapControl x:Name="MainMap" 
                         Grid.Row="1" 
                         Margin="0" 
                         BorderBrush="Orange" 
                         BorderThickness="2"/>

        <!-- Панель управления (Зум и Домой) -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,20,20">

            <Border x:Name="ZoomButtonsBorder" Background="White" CornerRadius="8" Padding="5" Margin="0,0,0,10">
                <StackPanel>
                    <Button x:Name="ZoomInButton" Content="+" 
                            Width="40" Height="40" 
                            FontSize="20" FontWeight="Bold"
                            Background="White" BorderBrush="#DDD" Foreground="Black"
                            Cursor="Hand" Click="ZoomIn_Click" ToolTip="Приблизить"/>
                    <Button x:Name="ZoomOutButton" Content="−" 
                            Width="40" Height="40" 
                            FontSize="20" FontWeight="Bold"
                            Background="White" BorderBrush="#DDD" Foreground="Black"
                            Margin="0,5,0,0" Cursor="Hand" Click="ZoomOut_Click" ToolTip="Отдалить"/>
                </StackPanel>
            </Border>

            <Border x:Name="HomeButtonBorder" Background="White" CornerRadius="8" Padding="5">
                <Button x:Name="HomeButton" Content="🏠" 
                        Width="40" Height="40" 
                        FontSize="18"
                        Background="White" BorderBrush="#DDD" Foreground="Black"
                        Cursor="Hand" Click="GoHome_Click"
                        ToolTip="Вернуться к центру пожарной части"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>