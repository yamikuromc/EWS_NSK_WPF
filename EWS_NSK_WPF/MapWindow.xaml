<Window x:Class="EWS_NSK_WPF.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        Title="Карта пожарных гидрантов" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#002864">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Компактная шапка -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Background="#1E1E1E" Padding="10,8" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MapTitleText" 
                               Text="КАРТА ПОЖАРНЫХ ГИДРАНТОВ" 
                               FontSize="16" FontWeight="Bold" Foreground="Orange"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " Foreground="Gray" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UserInfoLabel" 
                               FontSize="12" Foreground="White" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Поиск -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox" 
                         Grid.Column="0"
                         Height="28" 
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         Background="White"
                         Foreground="Black"
                         BorderBrush="#555"
                         Padding="5,3"
                         ToolTip="Введите номер, адрес или координаты"
                         KeyDown="SearchTextBox_KeyDown"/>  

                    <Button Grid.Column="1"
                            Content="🔍"
                            Width="32" Height="28"
                            Margin="5,0,0,0"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            Click="SearchHydrant_Click"
                            ToolTip="Поиск"/>

                    <Button Grid.Column="2"
                            Content="✖"
                            Width="32" Height="28"
                            Margin="5,0,0,0"
                            Background="#003C78"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            Click="ClearSearch_Click"
                            ToolTip="Очистить"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Карта -->
        <wpf:GMapControl x:Name="MainMap" 
                         Grid.Row="1" 
                         Margin="0" 
                         BorderBrush="Orange" 
                         BorderThickness="2"/>

        <!-- Панель управления -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,20,20">

            <!-- Кнопки зума (ДОБАВЛЕНЫ x:Name) -->
            <Border x:Name="ZoomButtonsBorder" Background="White" CornerRadius="8" Padding="5" Margin="0,0,0,10">
                <StackPanel>
                    <Button x:Name="ZoomInButton" Content="+" 
                            Width="40" Height="40" 
                            FontSize="20" FontWeight="Bold"
                            Background="White" 
                            BorderBrush="#DDD"
                            Foreground="Black"
                            Cursor="Hand"
                            Click="ZoomIn_Click"
                            ToolTip="Приблизить"/>
                    <Button x:Name="ZoomOutButton" Content="−" 
                            Width="40" Height="40" 
                            FontSize="20" FontWeight="Bold"
                            Background="White" 
                            BorderBrush="#DDD"
                            Foreground="Black"
                            Margin="0,5,0,0"
                            Cursor="Hand"
                            Click="ZoomOut_Click"
                            ToolTip="Отдалить"/>
                </StackPanel>
            </Border>

            <!-- Кнопка "Домой" (ДОБАВЛЕНЫ x:Name) -->
            <Border x:Name="HomeButtonBorder" Background="White" CornerRadius="8" Padding="5">
                <Button x:Name="HomeButton" Content="🏠" 
                        Width="40" Height="40" 
                        FontSize="18"
                        Background="White" 
                        BorderBrush="#DDD"
                        Foreground="Black"
                        Cursor="Hand"
                        Click="GoHome_Click"
                        ToolTip="Вернуться к центру Новосибирска"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>