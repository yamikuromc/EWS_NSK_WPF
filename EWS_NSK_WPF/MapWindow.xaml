<Window x:Class="EWS_NSK_WPF.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:wpf="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        Title="Карта пожарных гидрантов" 
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#002864">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и информация о пользователе -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="MapTitleText" 
               Text="КАРТА ПОЖАРНЫХ ГИДРАНТОВ" 
               FontSize="24" FontWeight="Bold" Foreground="Orange"/>
            <TextBlock x:Name="UserInfoLabel" 
               FontSize="14" Foreground="White" Margin="0,10,0,0"/>
            <TextBlock x:Name="PermissionsLabel" 
               FontSize="12" Foreground="LightGray" FontStyle="Italic" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Интерактивная карта -->
        <wpf:GMapControl x:Name="MainMap" 
                    Grid.Row="1" 
                    Margin="10" 
                    BorderBrush="Orange" 
                    BorderThickness="2"/>

        <!-- Кнопки действий (будем скрывать/показывать их из кода в зависимости от роли!) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnAdd" Content="➕ Добавить ПГ" Width="120" Height="35" 
                    Margin="0,0,10,0" Background="Green" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Visibility="Collapsed"/>

            <Button x:Name="BtnEdit" Content="✏️ Редактировать" Width="120" Height="35" 
                    Margin="0,0,10,0" Background="Orange" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Visibility="Collapsed"/>

            <Button Content="Закрыть" Width="100" Height="35" 
                    Background="#555" Foreground="White" BorderBrush="Transparent"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>