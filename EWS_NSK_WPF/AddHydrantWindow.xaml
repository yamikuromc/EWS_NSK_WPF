<Window x:Class="EWS_NSK_WPF.AddHydrantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый гидрант" 
        Width="550" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Координаты (только для чтения) -->
                <TextBlock Text="📍 Координаты точки на карте" FontSize="12" FontWeight="Bold" 
                           Foreground="{DynamicResource LabelForeground}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Широта" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                        <TextBox Text="{Binding NewHydrant.LatitudeD, StringFormat=F6}" 
                                 IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Долгота" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                        <TextBox Text="{Binding NewHydrant.LongitudeD, StringFormat=F6}" 
                                 IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Основные поля -->
                <TextBlock Text="Основные данные" FontSize="12" FontWeight="Bold" 
                           Foreground="{DynamicResource LabelForeground}" Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Номер гидранта *" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                        <TextBox Text="{Binding NewHydrant.EwsNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource InputBackground}" 
                                 Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" 
                                 Padding="5,3"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Статус" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                        <ComboBox ItemsSource="{Binding AvailableStatuses}" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedStatusCode, Mode=TwoWay}"
                                  Background="White" Foreground="Black"
                                  BorderBrush="{DynamicResource InputBorderBrush}" 
                                  Padding="5,3" Height="28"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Адрес (объект)" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                    <TextBox Text="{Binding NewHydrant.EwsAddressObjectCod, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{DynamicResource InputBackground}" 
                             Foreground="{DynamicResource InputForeground}"
                             BorderBrush="{DynamicResource InputBorderBrush}" 
                             Padding="5,3"/>
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Номер дома" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                        <TextBox Text="{Binding NewHydrant.EwsHouseNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource InputBackground}" 
                                 Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" 
                                 Padding="5,3"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Диаметр трубы (мм)" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                        <TextBox Text="{Binding NewHydrant.EwsDiameterWsCod, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource InputBackground}" 
                                 Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" 
                                 Padding="5,3"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Привязка (описание расположения)" FontSize="11" Foreground="{DynamicResource LabelForeground}"/>
                    <TextBox Text="{Binding NewHydrant.EwsPriviazka, UpdateSourceTrigger=PropertyChanged}" 
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="{DynamicResource InputBackground}" 
                             Foreground="{DynamicResource InputForeground}"
                             BorderBrush="{DynamicResource InputBorderBrush}" 
                             Padding="5,3"/>
                </StackPanel>

                <!-- Сообщение об ошибке валидации -->
                <TextBlock Text="{Binding ValidationError}" 
                           Foreground="Red" FontSize="11" FontWeight="Bold"
                           Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"
                           Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="✅ Создать" Width="110" Height="28" Margin="0,0,10,0"
                    Background="#4CAF50" Foreground="White" BorderBrush="Transparent"
                    Command="{Binding SaveCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

            <Button Content="❌ Отмена" Width="100" Height="28"
                    Background="{DynamicResource ButtonCancelBackground}" Foreground="White" BorderBrush="Transparent"
                    Command="{Binding CancelCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>