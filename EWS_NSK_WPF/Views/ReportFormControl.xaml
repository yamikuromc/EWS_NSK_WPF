<UserControl x:Class="EWS_NSK_WPF.Views.ReportFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- ═══ СТИЛИ COMBOBOX (с поиском) ═══ -->
        <Style x:Key="DocComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="4,-4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"/>
                                                <TextBlock Grid.Column="1" Text="▼" FontSize="8"
                                                           Foreground="#666666"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="250">
                                    <StackPanel>
                                        <TextBox Margin="4" Padding="4,2"
                                                 FontSize="11" BorderBrush="#CCCCCC" BorderThickness="1"
                                                 TextChanged="ComboBoxSearch_TextChanged"/>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ СТИЛИ ТАБЛИЦЫ ОТЧЁТА ═══ -->
        <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="TableCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <!-- Штатный ScrollViewer: колёсико скроллит лист, попап сам скроллит список -->
    <ScrollViewer x:Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <StackPanel x:Name="PagesContainer" Orientation="Vertical">

            <!-- ═══ СТРАНИЦА 1 ═══ -->
            <Border x:Name="Page1Border"
                    Background="White"
                    Width="1684" Height="1191"
                    Padding="50, 40, 50, 40"
                    Margin="20"
                    BorderBrush="#CCCCCC" BorderThickness="1">

                <StackPanel x:Name="Page1Content">
                    <!-- ЗАГОЛОВОК -->
                    <TextBlock x:Name="ReportTitle"
                               Text="Список неисправных пожарных гидрантов и водоемов,"
                               FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"/>

                    <!-- ТЕКСТ С COMBOBOX'АМИ -->
                    <TextBlock FontSize="12" TextAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap" LineHeight="24">
                        <Run Text="находящихся на территории "/>
                        <InlineUIContainer>
                            <ComboBox x:Name="TerritoryCombo" Width="220"
                                      Style="{StaticResource DocComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource DocComboItemStyle}"/>
                        </InlineUIContainer>
                        <Run Text=" по итогам "/>
                        <InlineUIContainer>
                            <ComboBox x:Name="SeasonCombo" Width="120"
                                      Style="{StaticResource DocComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource DocComboItemStyle}"/>
                        </InlineUIContainer>
                        <Run Text=" проверки "/>
                        <InlineUIContainer>
                            <ComboBox x:Name="YearCombo" Width="90"
                                      Style="{StaticResource DocComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource DocComboItemStyle}"/>
                        </InlineUIContainer>
                        <Run Text=" года"/>
                    </TextBlock>

                    <!-- РАЗДЕЛИТЕЛЬ -->
                    <Line X1="0" Y1="0" X2="1584" Y2="0" Stroke="Black" StrokeThickness="1" Margin="0,0,0,15"/>

                    <!-- ТАБЛИЦА: колонки Auto (под текст), без фикс ширины → нет fill-хвоста -->
                    <DataGrid x:Name="HydrantsTable"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="Black"
                              BorderThickness="1"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              FontSize="9"
                              Margin="0,0,0,0"
                              Background="White"
                              Foreground="Black"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              CellStyle="{StaticResource TableCellStyle}"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              RowHeight="18"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Left"
                              PreviewMouseWheel="Table_PreviewMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Width="Auto" MinWidth="30" Binding="{Binding Number}"/>
                            <DataGridTextColumn Header="Наименование населенного пункта" Width="Auto" MinWidth="120" Binding="{Binding AddressObject}"/>
                            <DataGridTextColumn Header="Адрес привязки" Width="Auto" MinWidth="140" Binding="{Binding Address}"/>
                            <DataGridTextColumn Header="Наименование предприятия" Width="Auto" MinWidth="150" Binding="{Binding Owner}"/>
                            <DataGridTextColumn Header="Количество ПГ" Width="Auto" MinWidth="50" Binding="{Binding HydrantCount}"/>
                            <DataGridTextColumn Header="Диаметр водовода" Width="Auto" MinWidth="80" Binding="{Binding Diameter}"/>
                            <DataGridTextColumn Header="Количество ПВ" Width="Auto" MinWidth="50" Binding="{Binding WaterVolumeCount}"/>
                            <DataGridTextColumn Header="Емкость водоема" Width="Auto" MinWidth="80" Binding="{Binding WaterVolume}"/>
                            <DataGridTextColumn Header="Дата обнаружения неисправности" Width="Auto" MinWidth="100" Binding="{Binding FaultDate}"/>
                            <DataGridTextColumn Header="Отметка об устранении неисправности" Width="Auto" MinWidth="120" Binding="{Binding FixNote}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Место для «Составил» + сводной таблицы (добавляются кодом) -->
                    <StackPanel x:Name="Page1Footer"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>