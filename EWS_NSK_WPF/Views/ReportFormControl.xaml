<UserControl x:Class="EWS_NSK_WPF.Views.ReportFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Background="Transparent">
    <!-- Серый фон вокруг листа, как в Word -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <!-- Размеры листа А4 при 96 DPI: 794 x 1123 пикселя -->
        <Border Background="White" 
                Width="794" Height="1123" 
                Padding="70, 80, 70, 70" 
                Margin="20" 
                BorderBrush="#CCCCCC" BorderThickness="1">

            <StackPanel>
                <!-- 1. ЗАГОЛОВОК С ВЫПАДАЮЩИМИ СПИСКАМИ ВНУТРИ ТЕКСТА -->
                <TextBlock Text="Список неисправных пожарных гидрантов и водоемов," 
                           FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock FontSize="14" TextAlignment="Center" Margin="0,0,0,40" TextWrapping="Wrap" LineHeight="24">
                    <Run Text="находящихся на территории "/>
                    <InlineUIContainer>
                        <ComboBox x:Name="TerritoryCombo" Width="200" Margin="5,-4" SelectedIndex="2" FontSize="14">
                            <ComboBoxItem Content="р. п. Краснообск"/>
                            <ComboBoxItem Content="п. Элитный"/>
                            <ComboBoxItem Content="р. п. Краснообск и п. Элитный"/>
                        </ComboBox>
                    </InlineUIContainer>
                    <Run Text=" по итогам "/>
                    <InlineUIContainer>
                        <ComboBox x:Name="SeasonCombo" Width="120" Margin="5,-4" SelectedIndex="1" FontSize="14">
                            <ComboBoxItem Content="весенней"/>
                            <ComboBoxItem Content="осенней"/>
                        </ComboBox>
                    </InlineUIContainer>
                    <Run Text=" проверки "/>
                    <InlineUIContainer>
                        <ComboBox x:Name="YearCombo" Width="90" Margin="5,-4" SelectedIndex="3" FontSize="14">
                            <ComboBoxItem Content="2023"/>
                            <ComboBoxItem Content="2024"/>
                            <ComboBoxItem Content="2025"/>
                            <ComboBoxItem Content="2026"/>
                        </ComboBox>
                    </InlineUIContainer>
                    <Run Text=" года"/>
                </TextBlock>

                <!-- Разделительная линия -->
                <Line X1="0" Y1="0" X2="654" Y2="0" Stroke="Black" StrokeThickness="1" Margin="0,0,0,30"/>

                <!-- 2. БЛОК "СОСТАВИЛ" -->
                <TextBlock Text="Составил:" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock x:Name="AuthorPositionText" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock x:Name="AuthorNameText" FontSize="12" Margin="0,0,0,40" FontWeight="Bold"/>

                <!-- 3. КНОПКА ДЕЙСТВИЯ (внизу листа) -->
                <Button x:Name="GenerateButton" 
                        Content="💾 Сформировать и сохранить Word-документ" 
                        Width="300" Height="45" 
                        HorizontalAlignment="Center"
                        Background="#4CAF50" Foreground="White" 
                        FontWeight="Bold" FontSize="14"
                        BorderBrush="Transparent" Cursor="Hand"
                        Click="GenerateButton_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>