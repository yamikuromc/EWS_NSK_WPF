<Window x:Class="EWS_NSK_WPF.ReferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочники" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#002864">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ: Заголовок и инфо -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="СПРАВОЧНИКИ" FontSize="24" FontWeight="Bold" Foreground="Orange"/>
            <TextBlock x:Name="UserInfoLabel" FontSize="14" Foreground="White" Margin="0,10,0,0"/>
            <TextBlock x:Name="PermissionsLabel" FontSize="12" Foreground="LightGray" FontStyle="Italic" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- СРЕДНЯЯ ЧАСТЬ: Таблица данных с горизонтальным скроллом -->
        <Border Grid.Row="1" Background="#003C78" CornerRadius="10" BorderBrush="Orange" BorderThickness="2" Padding="10">
            <!-- ScrollViewer с горизонтальным скроллом -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DataGrid x:Name="ReferenceDataGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          Background="Transparent" 
                          Foreground="White" 
                          BorderBrush="Transparent"
                          RowBackground="#1A003C78" 
                          AlternatingRowBackground="#1A00143C"
                          HeadersVisibility="Column"
                          FontSize="14"
                          GridLinesVisibility="Horizontal">

                    <!-- Стиль для заголовков таблицы -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#002864"/>
                            <Setter Property="Foreground" Value="Orange"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderBrush" Value="Orange"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </ScrollViewer>
        </Border>

        <!-- НИЖНЯЯ ЧАСТЬ: Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Закрыть" Width="100" Height="35" Background="#555" Foreground="White" 
                    BorderBrush="Transparent" Click="CloseButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>