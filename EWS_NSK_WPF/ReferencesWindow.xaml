<Window x:Class="EWS_NSK_WPF.ReferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EWS_NSK_WPF"
        Title="Справочники" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#002864">

    <Window.Resources>
        <!-- Конвертер для скрытия подсказки поиска, когда в поле есть текст -->
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ЧАСТЬ: Заголовок и кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="СПРАВОЧНИКИ" FontSize="22" FontWeight="Bold" Foreground="Orange"/>
                <TextBlock x:Name="UserInfoLabel" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenMapButton" Content="🗺️ Открыть карту" Width="130" Height="28" 
                        Background="#003C78" Foreground="White" BorderBrush="Orange" BorderThickness="1"
                        Margin="0,0,10,0" Cursor="Hand" Click="OpenMapButton_Click"/>

                <StackPanel x:Name="AdminButtons" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="EditButton" Content="Режим редактирования" Width="140" Height="28" 
                            Background="#FF9800" Foreground="White" BorderBrush="Transparent" 
                            Margin="0,0,10,0" Cursor="Hand" Click="EditButton_Click"/>
                    <Button x:Name="SaveButton" Content="Сохранить изменения" Width="140" Height="28" 
                            Background="#4CAF50" Foreground="White" BorderBrush="Transparent" 
                            Cursor="Hand" Click="SaveButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ОСНОВНАЯ ЧАСТЬ: Левая панель + (Поиск и Таблица) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ -->
            <Border Grid.Column="0" Background="#003C78" CornerRadius="4" BorderBrush="Orange" BorderThickness="1" Margin="0,0,5,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Справочники:" FontSize="12" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,8"/>

                    <Button Content="Подразделения ППС" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReferenceItem_Click" Tag="tbl_Fire3_Unit"/>
                    <Button Content="Адресные объекты" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReferenceItem_Click" Tag="tbl_RS4_AddressObject"/>
                    <Button Content="Характеристики" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReferenceItem_Click" Tag="tbl_EWS_Type"/>
                    <Button Content="Параметры проверок" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReferenceItem_Click" Tag="tbl_CheckEWS_StatusEWS"/>
                    <Button Content="Балансодержатели" FontSize="11" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="6,6" Margin="0,1" Cursor="Hand" Click="ReferenceItem_Click" Tag="tbl_EWS_Owner"/>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ: Поиск + Таблица -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Поиск -->
                    <RowDefinition Height="*"/>
                    <!-- Таблица -->
                </Grid.RowDefinitions>

                <!-- Панель поиска -->
                <Border Grid.Row="0" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox" Grid.Column="0" Height="28" FontSize="12" Padding="8,4"
                                 TextChanged="SearchTextBox_TextChanged"
                                 Background="White" BorderBrush="Orange" BorderThickness="1"/>

                        <TextBlock Grid.Column="0" Text="🔍 Поиск по таблице..." Foreground="Gray" FontSize="12"
                                   Margin="10,6,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding ElementName=SearchTextBox, Path=Text, Converter={StaticResource EmptyToVisibilityConverter}, FallbackValue=Visible}"/>

                        <Button Grid.Column="1" Content="Очистить" Width="70" Height="28" Margin="5,0,0,0"
                                Background="#003C78" Foreground="White" BorderBrush="Orange" BorderThickness="1"
                                Cursor="Hand" Click="ClearSearch_Click"/>
                    </Grid>
                </Border>

                <!-- Таблица -->
                <Border Grid.Row="1" Background="White" CornerRadius="4" BorderBrush="Orange" BorderThickness="1" Padding="4">
                    <DataGrid x:Name="ReferenceDataGrid" 
                              AutoGenerateColumns="True" 
                              IsReadOnly="True" 
                              CanUserAddRows="False"
                              Background="White"
                              Foreground="Black"
                              BorderBrush="Transparent"
                              RowBackground="White"
                              AlternatingRowBackground="#F5F5F5"
                              HeadersVisibility="Column"
                              FontSize="11"
                              GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#003C78"/>
                                <Setter Property="Foreground" Value="Orange"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>