<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="NewLoadMap.mbtiles" />
    <None Remove="Resources\background.png" />
    <None Remove="Resources\EWSs_map.db" />
    <None Remove="Resources\exit.png" />
    <None Remove="Resources\guide_icon.png" />
    <None Remove="Resources\INPPV.db" />
    <None Remove="Resources\journal_icon.png" />
    <None Remove="Resources\logo.png" />
    <None Remove="Resources\map_icon.png" />
    <None Remove="Resources\moon_icon.png" />
    <None Remove="Resources\moon_icon_hd.png" />
    <None Remove="Resources\report_icon.png" />
    <None Remove="Resources\settings_icon.png" />
    <None Remove="Resources\sun_icon.png" />
    <None Remove="Resources\sun_icon_hd.png" />
    <None Remove="Resources\swap_icon.png" />
    <None Remove="Resources\swap_icon_hd.png" />
    <None Remove="Resources\tablet_icon.png" />
    <None Remove="Resources\tablet_icon_hd.png" />
    <None Remove="Resources\tile_frame.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="NewLoadMap.mbtiles">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\EWSs_map.db">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\INPPV.db">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GMap.NET.Core" Version="2.1.7" />
    <PackageReference Include="GMap.NET.WinPresentation" Version="2.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Data.SQLite.EF6" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\exit.png" />
